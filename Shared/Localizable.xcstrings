    "card.send.note": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会一起发图片和 .homecard 文件；家人用本 App 打开文件就能存下全部照片，离线也能看。"
          }
